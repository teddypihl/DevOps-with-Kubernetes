{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "broadcaster",
    "namespace": "project"
  },
  "spec": {
    "progressDeadlineSeconds": 600,
    "replicas": 1,
    "revisionHistoryLimit": 10,
    "selector": {
      "matchLabels": {
        "app": "broadcaster"
      }
    },
    "strategy": {
      "rollingUpdate": {
        "maxSurge": "25%",
        "maxUnavailable": "25%"
      },
      "type": "RollingUpdate"
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "broadcaster"
        }
      },
      "spec": {
        "containers": [
          {
            "env": [
              {
                "name": "NATS_URL",
                "value": "nats://my-nats.nats.svc.cluster.local:4222"
              },
              {
                "name": "WEBHOOK_URL",
                "valueFrom": {
                  "secretKeyRef": {
                    "key": "WEBHOOK_URL",
                    "name": "broadcaster-webhook"
                  }
                }
              }
            ],
            "image": "broadcaster",
            "imagePullPolicy": "IfNotPresent",
            "name": "broadcaster",
            "resources": {
              "limits": {
                "cpu": "100m",
                "memory": "128Mi"
              },
              "requests": {
                "cpu": "10m",
                "memory": "32Mi"
              }
            },
            "terminationMessagePath": "/dev/termination-log",
            "terminationMessagePolicy": "File"
          }
        ],
        "dnsPolicy": "ClusterFirst",
        "restartPolicy": "Always",
        "schedulerName": "default-scheduler",
        "securityContext": {},
        "terminationGracePeriodSeconds": 30
      }
    }
  }
}
